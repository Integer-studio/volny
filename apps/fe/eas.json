{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "20.20.2",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:5135/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "node": "20.20.2",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.volny.limit6.eu/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "node": "20.20.2",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.volny.limit6.eu/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
